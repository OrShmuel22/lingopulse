{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "lingopulse",
  "title": "LingoPulse",
  "description": "Local English refinement via Ollama",
  "icon": "extension-icon.png",
  "author": "me",
  "categories": ["Productivity"],
  "license": "MIT",
  "commands": [
    {
      "name": "hello",
      "title": "LingoPulse Hello",
      "subtitle": "LingoPulse",
      "description": "Verifies the Python daemon is reachable",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.13",
    "@raycast/utils": "^2.2.4",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "eslint": "^9",
    "prettier": "^3",
    "typescript": "^5"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
